FROM node:20-alpine AS build
WORKDIR /app

COPY apps/web/package*.json ./
RUN npm ci

COPY apps/web/ ./

ARG VITE_API_BASE_URL="https://hirewise-prod-api-pofxtzi7yq-uc.a.run.app"
ARG VITE_CLERK_PUBLISHABLE_KEY="pk_test_aGVscGluZy1hbmVtb25lLTQ3MzAuY2xlcmsuYWNjb3VudHMuZGV2JA"
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_CLERK_PUBLISHABLE_KEY=$VITE_CLERK_PUBLISHABLE_KEY

RUN npm run build

FROM nginx:alpine AS final

# Copy nginx template — uses $PORT at runtime (Cloud Run injects PORT=8080)
COPY apps/web/nginx.conf /etc/nginx/conf.d/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html

# Cloud Run sets $PORT; substitute it into nginx config then start nginx
ENV PORT=8080
EXPOSE 8080

CMD ["/bin/sh", "-c", "envsubst '$PORT' < /etc/nginx/conf.d/default.conf.template > /etc/nginx/conf.d/default.conf && nginx -g 'daemon off;'"]
