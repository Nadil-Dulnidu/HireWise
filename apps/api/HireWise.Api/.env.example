# ==============================================================================
# HireWise.Api - Environment Configuration Template
# Copy this file to .env and replace placeholder values with your real secrets.
# ==============================================================================

# ASP.NET Core Runtime Environment (Development | Staging | Production)
ASPNETCORE_ENVIRONMENT=Development

# Database Configuration (PostgreSQL)
# Supports standard ADO.NET connection strings or postgresql:// URIs
DATABASE_URL=Host=localhost;Port=5432;Database=hirewise_db;Username=postgres;Password=your_postgres_password
# Or PostgreSQL URI format:
# DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/hirewise_db

# Auto-apply database migrations on startup (true for dev, false for prod)
DATABASE_APPLY_MIGRATIONS_ON_STARTUP=true

# Clerk Authentication & Webhooks
# Authority is your Clerk Frontend API URL (from Clerk Dashboard > API Keys / JWT Templates)
CLERK_AUTHORITY=https://your-instance.clerk.accounts.dev
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_WEBHOOK_SECRET=whsec_your_clerk_webhook_signing_secret

# AI Orchestration Service (FastAPI / Gemini backend)
AI_SERVICE_BASE_URL=http://localhost:8000
AI_SERVICE_API_KEY=hw_ai_service_secret_key

# CORS Allowed Origins (comma-separated list for frontend clients)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4173

# Google Calendar Integration (interview calendar events)
# Create a GCP project, enable Calendar API, create a service account key JSON file
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_SERVICE_ACCOUNT_KEY_PATH=./google-service-account.json
GOOGLE_CALENDAR_ID=primary

# Resend Email Service (transactional emails)
# Sign up at https://resend.com — free tier supports 100 emails/day
RESEND_ENABLED=false
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_ADDRESS=HireWise <hirewise.team@gmail.com>
