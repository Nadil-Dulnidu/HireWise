{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Clerk": {
    "Authority": "https://helping-anemone-4730.clerk.accounts.dev",
    "WebhookSecret": ""
  },
  "AiService": {
    "BaseUrl": "http://localhost:8000",
    "ApiKey": "hw_ai_service_secret_key"
  },
  "Storage": {
    "Provider": "LocalStorage",
    "Gcp": {
      "BucketName": "hirewise-resumes",
      "ServiceAccountKeyPath": "",
      "ServiceAccountJson": ""
    }
  },
  "GoogleCalendar": {
    "Enabled": false,
    "ServiceAccountKeyPath": "./google-service-account.json",
    "ServiceAccountJson": "",
    "CalendarId": "primary"
  },
  "Resend": {
    "Enabled": false,
    "ApiKey": "",
    "FromAddress": "HireWise <onboarding@resend.dev>"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000",
      "http://localhost:4173"
    ]
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*:/api/resumes/upload",
        "Period": "1m",
        "Limit": 10
      },
      {
        "Endpoint": "*:/api/webhooks/*",
        "Period": "1m",
        "Limit": 60
      },
      {
        "Endpoint": "*:/api/jobs/*/applications",
        "Period": "1m",
        "Limit": 20
      },
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 120
      }
    ]
  }
}
