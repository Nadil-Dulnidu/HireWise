# HireWise AI Orchestrator Environment Variables

# Project Configuration
PROJECT_NAME="HireWise AI Orchestrator"
VERSION="0.1.0"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# Internal Service-to-Service Authentication
AI_SERVICE_API_KEY="hw_ai_service_secret_key"

# ASP.NET Core API Integration (Callback target)
DOTNET_API_BASE_URL="http://localhost:5101"
DOTNET_API_INTERNAL_KEY="hw_internal_callback_key"

# PostgreSQL Database (Supabase / Local)
DATABASE_URL="postgresql://postgres:Pamiya@440@localhost:5432/hirewise_db"
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# Google Gemini / GCP Vertex AI / Agent Platform Configuration
# Option 1: Google AI Studio (API Key based)
# Get your Gemini API key from https://aistudio.google.com/
GOOGLE_API_KEY=""

# Option 2: GCP Vertex AI / Vertex AI Agent Builder & Model Garden
# Set USE_VERTEX_AI=true to use Google Cloud Vertex AI infrastructure
USE_VERTEX_AI=true
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
VERTEX_PROJECT_ID="your-gcp-project-id"
VERTEX_LOCATION="us-central1"
# Path to service account JSON key file (or leave empty if using default ADC / gcloud auth)
GOOGLE_APPLICATION_CREDENTIALS=""

# Model & Reasoning Engine / Agent Selection
# Examples: gemini-1.5-pro, gemini-1.5-flash, gemini-2.0-flash-exp
GEMINI_MODEL="gemini-2.5-pro"
GEMINI_EMBEDDING_MODEL="text-embedding-004"

